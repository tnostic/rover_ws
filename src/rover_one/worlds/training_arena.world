<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="turtlebot3_training_arena">
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.65 0.72 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Initial Gazebo GUI camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-9 -7 6 0 0.35 0.9</pose>
      </camera>
    </gui>

    <!-- GPS origin (matches gps_waypoint_follower.cpp: Moscow) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>55.751244</latitude_deg>
      <longitude_deg>37.618423</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.25 -0.9</direction>
    </light>

    <!-- Soft fill light for warmer shading -->
    <light name="fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.35 0.40 0.55 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.3 -0.4 -0.9</direction>
    </light>

    <model name="arena">
      <static>true</static>

      <link name="floor">
        <pose>0 0 -0.025 0 0 0</pose>
        <collision name="floor_collision">
          <geometry><box><size>12.0 8.0 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>12.0 8.0 0.05</size></box></geometry>
          <material>
            <ambient>0.42 0.43 0.44 1</ambient>
            <diffuse>0.42 0.43 0.44 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer boundary -->
      <link name="north_wall">
        <pose>0 4.0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12.2 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.15 0.5</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.12 0.28 0.48 1</diffuse></material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>0 -4.0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12.2 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.15 0.5</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.12 0.28 0.48 1</diffuse></material>
        </visual>
      </link>
      <link name="east_wall">
        <pose>6.0 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 8.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.0 0.5</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.12 0.28 0.48 1</diffuse></material>
        </visual>
      </link>
      <link name="west_wall">
        <pose>-6.0 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 8.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.0 0.5</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.12 0.28 0.48 1</diffuse></material>
        </visual>
      </link>

      <!-- Start and target pads -->
      <link name="start_pad">
        <pose>-4.25 0 0.004 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.008</size></box></geometry>
          <material><ambient>0.05 0.55 0.25 1</ambient><diffuse>0.05 0.55 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="goal_pad">
        <pose>3.75 0 0.004 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.008</size></box></geometry>
          <material><ambient>0.75 0.12 0.08 1</ambient><diffuse>0.75 0.12 0.08 1</diffuse></material>
        </visual>
      </link>

      <!-- Center lane markers -->
      <link name="lane_marker_1"><pose>-2.0 0 0.006 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.55 0.05 0.012</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="lane_marker_2"><pose>0.0 0 0.006 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.55 0.05 0.012</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="lane_marker_3"><pose>2.0 0 0.006 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.55 0.05 0.012</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>

      <!-- Offset obstacles -->
      <link name="block_1">
        <pose>-1.55 1.25 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.55 0.55 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.5</size></box></geometry>
          <material><ambient>0.75 0.42 0.08 1</ambient><diffuse>0.75 0.42 0.08 1</diffuse></material>
        </visual>
      </link>
      <link name="block_2">
        <pose>0.35 -1.30 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.55 0.55 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.5</size></box></geometry>
          <material><ambient>0.75 0.42 0.08 1</ambient><diffuse>0.75 0.42 0.08 1</diffuse></material>
        </visual>
      </link>
      <link name="block_3">
        <pose>2.20 1.15 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.55 0.55 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.5</size></box></geometry>
          <material><ambient>0.75 0.42 0.08 1</ambient><diffuse>0.75 0.42 0.08 1</diffuse></material>
        </visual>
      </link>

      <!-- Cylinders -->
      <link name="pillar_1">
        <pose>-3.0 -2.1 0.35 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_2">
        <pose>1.25 2.25 0.35 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>

      <!-- Gates -->
      <link name="gate_left_1"><pose>-0.75 0.95 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 0.18 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 0.18 0.8</size></box></geometry>
          <material><ambient>0.08 0.45 0.60 1</ambient><diffuse>0.08 0.45 0.60 1</diffuse></material>
        </visual>
      </link>
      <link name="gate_right_1"><pose>-0.75 0.15 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 0.18 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 0.18 0.8</size></box></geometry>
          <material><ambient>0.08 0.45 0.60 1</ambient><diffuse>0.08 0.45 0.60 1</diffuse></material>
        </visual>
      </link>
      <link name="gate_left_2"><pose>2.9 -0.15 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 0.18 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 0.18 0.8</size></box></geometry>
          <material><ambient>0.08 0.45 0.60 1</ambient><diffuse>0.08 0.45 0.60 1</diffuse></material>
        </visual>
      </link>
      <link name="gate_right_2"><pose>2.9 -0.95 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 0.18 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 0.18 0.8</size></box></geometry>
          <material><ambient>0.08 0.45 0.60 1</ambient><diffuse>0.08 0.45 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>